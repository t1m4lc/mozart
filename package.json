{
  "name": "@mozart/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm nx run desktop:tauri-dev",
    "typecheck": "pnpm nx run-many -t typecheck",
    "lint": "pnpm nx run-many -t lint",
    "test": "pnpm nx run-many -t test",
    "build": "pnpm nx run-many -t build",
    "tauri-check": "cd apps/desktop/src-tauri && cargo check && cd -",
    "tauri-test": "cd apps/desktop/src-tauri && cargo build --tests && cd -",
    "seed": "sqlite3 ~/.local/share/build.mozart.desktop/mozart.db < apps/desktop/src-tauri/tests/fixtures/seed-shell.sql",
    "reset-db": "rm -rf ~/.local/share/build.mozart.desktop/",
    "seed-fresh": "pnpm reset-db && echo 'reset done — start pnpm dev to recreate schema, then run pnpm seed in another shell'"
  },
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "devDependencies": {
