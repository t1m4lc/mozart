{
  "name": "@mozart/source",
  "version": "0.1.0-beta.2.1",
  "license": "MIT",
  "sideEffects": false,
  "scripts": {
    "dev": "pnpm nx run desktop-tauri:tauri-dev",
    "dev:web": "trap 'kill 0' EXIT INT TERM; pnpm dev:web:functions & pnpm nx serve web",
    "dev:web:functions": "cd apps/web && wrangler pages dev functions --port 8788 --compatibility-date=2025-05-01",
    "typecheck": "pnpm nx run-many -t typecheck",
    "lint": "pnpm nx run-many -t lint",
    "test": "pnpm nx run-many -t test",
    "build": "pnpm nx run-many -t build",
    "tauri-check": "pnpm nx run desktop-tauri:cargo-check",
    "tauri-test": "pnpm nx run desktop-tauri:cargo-test",
    "seed": "cargo run --manifest-path apps/desktop-tauri/Cargo.toml --bin seed_demo -- --demo",
    "reset-db": "cargo run --manifest-path apps/desktop-tauri/Cargo.toml --bin seed_demo -- --clean",
    "seed-fresh": "pnpm seed",
    "purge:landing-cache": "./tools/mozart-landing-cf-page-purge-cache.sh",
    "purge:tauri": "rm -rf apps/desktop-tauri/target && rm -rf node_modules/.cache .nx/cache && nx reset",
    "try": "rm -rf ~/.config/build.mozart.desktop && rm -rf ~/.local/share/build.mozart.desktop && pnpm tauri build --config '{\"bundle\":{\"createUpdaterArtifacts\":false}}' && ./apps/desktop-tauri/target/release/bundle/appimage/mozart_0.1.0-beta.1_amd64.AppImage",
    "prepare": "husky && chmod +x .husky/pre-commit .husky/pre-push"
  },
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "devDependencies": {
