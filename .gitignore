# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
# tauri-specta generated bindings (regenerated on every debug build)
apps/desktop/src/app/_bindings.ts
tmp/*
!tmp/ready-plans/
!tmp/done-plans/
out-tsc

# /discussion outputs (per-session, not history)
.context/

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

# Local environment config files
**/env.ts
**/env.*.ts

# Safe templates
!**/env.example.ts
!**/env.*.example.ts

.nx/cache
.nx/workspace-data
.claude/worktrees
.claude/settings.local.json

.angular

__screenshots__/
.gstack/

.nx/polygraph
