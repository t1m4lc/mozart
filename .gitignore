# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
# tauri-specta generated bindings (regenerated on every debug build)
apps/src/app/core/_bindings.ts
apps/desktop/src/app/core/_bindings.ts

# stale Rust build artifacts from the pre-refactor src-tauri location
# (Tauri shell now lives at apps/desktop-tauri/, which has its own .gitignore)
apps/desktop/src-tauri/
tmp/*
!tmp/ready-plans/
!tmp/done-plans/
out-tsc

# /discussion outputs (per-session, not history)
.context/

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

# Local environment config files
**/env.ts
**/env.*.ts

# .gitignore
.env
.env.local
.env.*.local
!**/.env.example

# Cloudflare Pages — local wrangler cache
.wrangler/

.nx/cache
.nx/workspace-data
.claude/worktrees
.claude/settings.local.json

.angular

__screenshots__/
.gstack/

.nx/polygraph
