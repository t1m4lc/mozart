#!/usr/bin/env sh
set -e

echo "pre-push: verifying scope tags..."
bash tools/verify-scope-tags.sh

echo "pre-push: lint + test + typecheck (affected)..."
CI=true pnpm nx affected -t lint test typecheck --parallel=3 --output-style=static --exclude=sandbox,sandbox-e2e

echo "pre-push: format check..."
pnpm nx format:check
