{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "mozart",
  "version": "0.1.0-beta.1",
  "identifier": "build.mozart.desktop",
  "build": {
    "frontendDist": "../../dist/apps/desktop/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "pnpm nx serve desktop",
    "beforeBuildCommand": "pnpm nx build desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Mozart",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "devtools": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "appimage", "deb", "dmg", "nsis"],
    "icon": [
      "../../libs/mozart-assets/src/desktop/app-icons/32x32.png",
      "../../libs/mozart-assets/src/desktop/app-icons/128x128.png",
      "../../libs/mozart-assets/src/desktop/app-icons/128x128@2x.png",
      "../../libs/mozart-assets/src/desktop/app-icons/icon.icns",
      "../../libs/mozart-assets/src/desktop/app-icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["mozart"]
      }
    },
    "updater": {
      "endpoints": ["https://dl.mozart.build/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwQ0ZCNTZBOERBMDAyQkMKUldTOEFxQ05hclhQUUhNNXlxT2dEMHRoVnpJRzRyYzBlbUpPemREOXlOWjRtS2FvL0R3VytTYTgK"
    }
  }
}
