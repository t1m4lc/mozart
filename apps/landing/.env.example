# PostHog product analytics (telemetry domain).
# Copy to .env.local (gitignored) and fill in real values.
#
# The "Project API key" from PostHog Cloud — public client key, prefixed `phc_`.
# Safe to ship in the bundle.
VITE_POSTHOG_KEY=

# Region host.
#   EU: https://eu.i.posthog.com
#   US: https://us.i.posthog.com
VITE_POSTHOG_HOST=https://us.i.posthog.com # or proxy like https://t.domain

# Internal-device opt-in token.
# SERVER-ONLY — no VITE_ prefix on purpose: this secret must never reach the
# client bundle. Set it in the Cloudflare Pages dashboard (Settings →
# Environment variables). The browser sends `?internal=<token>` in the URL;
# /api/analytics/set-internal-device compares against this value
# (constant-time) before setting the `mozart_internal_device` cookie.
INTERNAL_DEVICE_TOKEN=
