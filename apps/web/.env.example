# Copy this file to apps/web/.env and fill in your values.
# apps/web/.env is gitignored — never commit real keys.
#
# In CI: deploy-web.yml writes apps/web/.env from GitHub Variables/Secrets.
# In dev: paste your own keys from the Clerk/PostHog dashboards.
#
# See docs/setup-clerk.md for the Clerk setup walkthrough.

# Clerk publishable key — public, safe in the bundle (identifies your Clerk instance)
CLERK_PUBLISHABLE_KEY=pk_test_PASTE_YOUR_PUBLISHABLE_KEY_HERE

# PostHog analytics — leave empty to disable analytics (dev default)
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
