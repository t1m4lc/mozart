# Local environment for `wrangler pages dev` (apps/web Cloudflare Pages Functions).
#
# Copy this file to `apps/web/.env` and fill in the values.
# `apps/web/.env` is gitignored (root `.gitignore` covers `.env`).
# Production values live in the Cloudflare Pages dashboard → Settings →
# Environment variables (see docs/cloud-app/cloudflare-notes.md).

# Clerk Backend SDK secret key. Obtain from Clerk dashboard →
# API Keys → Secret keys. Used by functions/api/github/oauth-token.ts
# to fetch the user's Clerk-linked GitHub OAuth access token.
CLERK_SECRET_KEY=sk_test_REPLACE_ME
