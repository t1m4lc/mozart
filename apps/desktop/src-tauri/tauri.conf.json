{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "mozart",
  "version": "0.1.0-beta.1",
  "identifier": "build.mozart.desktop",
  "build": {
    "frontendDist": "../../../dist/apps/desktop/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "pnpm nx serve desktop",
    "beforeBuildCommand": "pnpm nx build desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Mozart",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "devtools": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["mozart"]
      }
    }
  }
}
