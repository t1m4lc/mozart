{
  "name": "desktop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/desktop/src",
  "tags": [
    "scope:app"
  ],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "syncGenerators": [
        "@juristr/nx-tailwind-sync:source-directives"
      ],
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/desktop",
        "browser": "apps/desktop/src/main.ts",
        "tsConfig": "apps/desktop/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/desktop/public"
          },
          {
            "glob": "**/!(*.md)",
            "input": "libs/mozart-assets/src/shared",
            "output": "assets/shared"
          }
        ],
        "styles": [
          "apps/desktop/src/styles.css"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1.5mb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "syncGenerators": [
        "@juristr/nx-tailwind-sync:source-directives"
      ],
      "configurations": {
        "production": {
          "buildTarget": "desktop:build:production"
        },
        "development": {
          "buildTarget": "desktop:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {}
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "desktop:build",
        "port": 4200,
        "staticFilePath": "dist/apps/desktop/browser",
        "spa": true
      }
    },
    "tauri-dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm tauri dev --config '{\"app\":{\"withGlobalTauri\":true}}'",
        "cwd": "apps/desktop"
      }
    },
    "tauri-build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production", "tauriSrc", "^production"],
      "outputs": [
        "{workspaceRoot}/dist/apps/desktop",
        "{projectRoot}/src-tauri/target/release/bundle"
      ],
      "dependsOn": ["build"],
      "options": {
        "command": "pnpm tauri build",
        "cwd": "apps/desktop"
      }
    },
    "cargo-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["tauriSrc"],
      "options": {
        "command": "cargo check",
        "cwd": "apps/desktop/src-tauri"
      }
    },
    "cargo-test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["tauriSrc"],
      "options": {
        "command": "cargo build --tests",
        "cwd": "apps/desktop/src-tauri"
      }
    }
  }
}
